{
  "name": "undp-chad-annual-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UNDP Chad Annual Report 2025 — interactive scrollytelling microsite (EN/FR)",
  "scripts": {
    "dev": "npm run js:dev & eleventy --serve --quiet",
    "build": "npm run js:build && eleventy",
    "js:build": "esbuild src/assets/js/main.js --bundle --minify --format=esm --outfile=src/assets/js/bundle.js",
    "js:dev": "esbuild src/assets/js/main.js --bundle --format=esm --outfile=src/assets/js/bundle.js --watch",
    "clean": "rm -rf _site src/assets/js/bundle.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  }
}
