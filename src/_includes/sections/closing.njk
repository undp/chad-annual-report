{%- import "sections/modal.njk" as modal with context %}
{%- set cp = en.closing.photos[0] if en.closing.photos else none %}
<section class="closing" aria-labelledby="closing-text"{% if cp %} style="--p-col:{{ cp.col }};--p-dy:{{ cp.dy }};--p-fw:{{ cp.fw }};--p-ext:{{ cp.by + cp.bh }}"{% endif %}>
  {%- if cp %}
  <div class="polaroids polaroids--{{ cp.side }} polaroids--placed" aria-hidden="false">
    <figure class="polaroid polaroid--{{ cp.side }}" style="--rot:{{ cp.rot }}deg;--fw:{{ cp.fw }}" data-parallax="stack">
      <div class="polaroid__frame">
        <picture>
          <source srcset="{{ (cp.src | replace('.jpg', '.webp')) | url }}" type="image/webp">
          <img src="{{ cp.src | url }}" width="{{ cp.w }}" height="{{ cp.h }}"
               alt="{{ (c.closing.photos[0].alt if c.closing.photos else '') | t(cp.alt) }}" loading="lazy" decoding="async">
        </picture>
      </div>
    </figure>
  </div>
  {%- endif %}
  <div class="closing__text" id="closing-text" data-anim="text-reveal">
    {%- for para in (c.closing.body | t(en.closing.body)).split('\n\n') %}
    <p>{{ para | emph | safe }}</p>
    {%- endfor %}
  </div>
  {{ modal.trigger('closing', c.closing.cta | t(en.closing.cta)) }}
  {{ modal.dialog('closing', c.closing.body | t(en.closing.body)) }}
</section>
