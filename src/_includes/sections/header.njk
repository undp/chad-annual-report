{# The Country Site Header of the UNDP Design System 2.0.3, with its markup and
   its compiled CSS (assets/vendor/undp-ds): the client checks this band against
   the system's own Storybook, so it is the system's component rather than a
   drawing of it. The arrangement on the right follows the 2024 global annual
   report, which the client gave as the reference: language switcher, then the
   download, and below 64em both move into the burger menu.

   Two departures from the Storybook markup, both for screen readers and both
   invisible: the language list is a disclosure (a button that says whether it
   is open, and plain links) rather than role="menu", which would promise arrow
   key navigation the system's script does not provide; and every button is a
   real <button type="button"> with aria-expanded kept in step by
   ui/site-header.js. #}
{%- set home = ('/' + lang + '/') | url %}
{%- set h = c.header %}
{%- set enH = en.header %}
{%- set pdf = (c.footer.file | t(en.footer.file)) | url %}

{%- macro download(extra) %}
  {%- if assets.reportPdf[lang] %}
  <a class="download-link {{ extra }}" href="{{ pdf }}" download>
  {%- else %}
  <span class="download-link download-link--pending {{ extra }}" title="{{ h.downloadPending | t(enH.downloadPending) }}">
  {%- endif %}
    {{ h.download | t(enH.download) }}
    <span class="download-animated" aria-hidden="true"><i></i></span>
  {%- if assets.reportPdf[lang] %}</a>{% else %}</span>{% endif %}
{%- endmacro %}

<header class="country-header" data-header>
  <section class="header">
    <div class="grid-container fluid">
      <div class="grid-x grid-margin-x align-content-middle">
        <div class="cell small-8 large-2 shrink align-self-middle top-left">
          <a class="logo" href="{{ home }}" title="{{ h.tagline | t(enH.tagline) }}">
            <img src="{{ '/assets/vendor/undp-ds/images/undp-logo-blue.svg' | asset }}" alt="UNDP" width="60" height="122">
          </a>
          <div class="site-title">
            <span><a href="{{ site.regionLink }}">{{ h.brand | t(enH.brand) }}</a></span>
            <span><a href="{{ home }}">{{ h.tagline | t(enH.tagline) }}</a></span>
          </div>
        </div>

        <div class="cell small-1 large-auto align-content-middle top-center"></div>

        <div class="cell small-3 large-auto top-right">
          <div class="dropdown-language" data-undpds-component="language-switcher">
            <button type="button" aria-expanded="false" aria-controls="language-list"
                    aria-label="{{ copy[lang].header.languageLabel }}, {{ h.selectLanguage | t(enH.selectLanguage) }}">
              {{ copy[lang].header.languageLabel }}
            </button>
            <ul id="language-list">
              {%- for l in site.langs %}{% if l != lang %}
              <li><a href="{{ ('/' + l + '/') | url }}" lang="{{ l }}" hreflang="{{ l }}" tabindex="-1">{{ copy[l].header.languageLabel }}</a></li>
              {%- endif %}{% endfor %}
            </ul>
          </div>

          <button class="menu-hamburger" type="button" aria-expanded="false" aria-controls="mobile-nav">
            <span class="hamburger-line line-top"></span>
            <span class="hamburger-line line-middle"></span>
            <span class="hamburger-line line-bottom"></span>
            {{ h.menu | t(enH.menu) }}
          </button>

          {{ download('download-link--header') }}
        </div>

        <div class="mobile-nav" id="mobile-nav">
          <div class="grid-x">
            <div class="cell mobile-links">
              <div class="mobile-nav-options">
                <a href="#mobile-languages" class="mob-lang-switcher" aria-controls="mobile-languages" aria-expanded="false">
                  <img src="{{ '/assets/vendor/undp-ds/images/language.svg' | asset }}" alt="" width="25" height="26">
                  {{ copy[lang].header.languageLabel }}
                </a>
                {{ download('') }}
              </div>
            </div>
            <div class="cell mob-sub-lang" id="mobile-languages">
              <button class="back-nav" type="button">
                <img src="{{ '/assets/vendor/undp-ds/images/back.svg' | asset }}" alt="" width="33" height="17">
                {{ h.back | t(enH.back) }}
              </button>
              <ul class="sub-sub-lang">
                <li>
                  <span>{{ h.selectLanguage | t(enH.selectLanguage) }}</span>
                  <ul>
                    {%- for l in site.langs %}
                    <li><a href="{{ ('/' + l + '/') | url }}" lang="{{ l }}" hreflang="{{ l }}"
                           {%- if l == lang %} aria-current="true"{% endif %}>{{ copy[l].header.languageLabel }}</a></li>
                    {%- endfor %}
                  </ul>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</header>
