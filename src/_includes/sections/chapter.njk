{# One chapter: gradient intro band + typed blocks (feature / cards / counters / photos).
   Structure comes from `enCh` (English is canonical); `ch` only provides the
   translated strings, with the `t` filter falling back to English.
   Photos are the tilted, white-bordered frames from the Figma design: the angle
   and the side they sit on are data, so translators never touch layout. #}

{%- import "sections/modal.njk" as modal with context %}

{%- macro polaroids(enPhotos, trPhotos) %}
{%- if enPhotos %}
<div class="polaroids polaroids--{{ enPhotos[0].side }}{% if enPhotos | length > 1 %} polaroids--stacked{% endif %}">
  {%- for p in enPhotos %}
  <figure class="polaroid polaroid--{{ p.side }}" style="--rot:{{ p.rot }}deg;--fw:{{ p.fw }}"
          data-parallax="stack">
    <div class="polaroid__frame">
      <picture>
        <source srcset="{{ (p.src | replace('.jpg', '.webp')) | url }}" type="image/webp">
        <img src="{{ p.src | url }}" width="{{ p.w }}" height="{{ p.h }}"
             alt="{{ trPhotos[loop.index0].alt | t(p.alt) }}" loading="lazy" decoding="async">
      </picture>
    </div>
  </figure>
  {%- endfor %}
</div>
{%- endif %}
{%- endmacro %}

<section class="chapter" id="{{ enCh.id }}" data-chapter="{{ enCh.id }}" aria-labelledby="ch-{{ enCh.id }}-title">
  <div class="chapter__intro">
    <div class="chapter__band" aria-hidden="true"></div>
    <div class="chapter__intro-text">
      <h2 class="chapter__title" id="ch-{{ enCh.id }}-title">{{ ch.title | t(enCh.title) }}</h2>
      <p class="chapter__lead" data-anim="text-reveal">{{ ch.intro | t(enCh.intro) }}</p>
    </div>
  </div>

  {%- for enB in enCh.blocks %}
  {%- set b = ch.blocks[loop.index0] %}
  {%- set blockId = enCh.id + '-' + loop.index %}
  {%- if enB.type == "feature" %}
  <div class="block block--feature {% if enB.align == 'right' %}block--right{% endif %}" data-anim="reveal">
    <div class="block__text" data-parallax="drift">
      <h3 class="block__heading">{{ b.heading | t(enB.heading) }}</h3>
      <p class="block__body" data-anim="text-reveal">{{ b.body | t(enB.body) }}</p>
      {%- if enB.cta %}{{ modal.trigger(blockId, b.cta | t(enB.cta)) }}{{ modal.dialog(blockId, b.heading | t(enB.heading)) }}{% endif %}
    </div>
    {{ polaroids(enB.photos, b.photos) }}
  </div>
  {%- elif enB.type == "counters" %}
  <div class="block block--counters" data-anim="reveal">
    <div class="block__text" data-parallax="drift">
      <h3 class="block__heading">{{ b.heading | t(enB.heading) }}</h3>
      <ul class="counters" role="list">
      {%- for it in enB.items %}
      <li class="counter">
        <span class="counter__value" data-counter="{{ it.value }}" data-suffix="{{ it.suffix }}">{{ it.value }}{{ it.suffix }}</span>
        <span class="counter__label">{{ b.items[loop.index0].label | t(it.label) }}</span>
      </li>
      {%- endfor %}
      </ul>
      {%- if enB.cta %}{{ modal.trigger(blockId, b.cta | t(enB.cta)) }}{{ modal.dialog(blockId, b.heading | t(enB.heading)) }}{% endif %}
    </div>
    {{ polaroids(enB.photos, b.photos) }}
  </div>
  {%- elif enB.type == "cards" %}
  <div class="block block--cards" data-anim="reveal">
    <div class="block__text" data-parallax="drift">
      <h3 class="block__heading">{{ b.heading | t(enB.heading) }}</h3>
      <ul class="cards" role="list">
      {%- for it in enB.items %}
      <li class="card">
        {%- if it.value %}<span class="card__value" data-counter="{{ it.value }}" data-suffix="{{ it.suffix }}">{{ it.value }}{{ it.suffix }}</span>{% endif %}
        {%- if it.title %}<span class="card__title">{{ b.items[loop.index0].title | t(it.title) }}</span>{% endif %}
        {%- if it.label %}<span class="card__label">{{ b.items[loop.index0].label | t(it.label) }}</span>{% endif %}
      </li>
      {%- endfor %}
      </ul>
      {%- if enB.cta %}{{ modal.trigger(blockId, b.cta | t(enB.cta)) }}{{ modal.dialog(blockId, b.heading | t(enB.heading)) }}{% endif %}
    </div>
    {{ polaroids(enB.photos, b.photos) }}
  </div>
  {%- elif enB.type == "photos" %}
  <div class="block block--photos" data-anim="reveal">
    <h3 class="block__heading">{{ b.heading | t(enB.heading) }}</h3>
    {{ polaroids(enB.photos, b.photos) }}
  </div>
  {%- endif %}
  {%- endfor %}
</section>
