{# "learn more" dialogs.

   Native <dialog> rather than a hand-rolled overlay: the focus trap, the Escape
   key, inertness of the page behind and the top-layer stacking are all browser
   behaviour, and every one of them is a thing hand-rolled modals get wrong.

   The dialog is emitted next to the button that opens it so it can borrow that
   block's heading as its accessible name — the prose frames have no title of
   their own, and a modal without an accessible name is a modal a screen reader
   announces as nothing at all.

   Two shapes, because the file draws two: a 1240-wide card that sets its copy
   in two columns (387:27, 387:120, and the table 158:3620) and a 732-wide card
   with a single column (387:203, 387:227, 387:236). Which one a dialog uses,
   where its columns divide and which side carries the figures are in the copy
   file: the file makes a different choice for each dialog, and a template that
   guessed would be wrong half the time. #}

{#- One run of paragraphs. `from` and `to` are indexes into the body, so the
    same macro sets a whole single-column dialog or one column of a wide one. #}
{%- macro prose(paras, m, from, to) %}
{%- for para in paras %}
{%- if loop.index0 >= from and loop.index0 < to %}
<p class="modal__body{% if m.leads and loop.index0 in m.leads %} modal__lead{% endif %}">{{ para | emph | safe }}</p>
{%- endif %}
{%- endfor %}
{%- endmacro %}

{#- The figures of a wide dialog, laid out as the file lays them: one or two to
    a row, indented inside their column, with a rule between the rows. #}
{%- macro figures(m, tr) %}
{%- set cols = m.figureCols or 1 %}
<div class="modal__figures" style="--fig-cols:{{ cols }}">
  {%- for f in m.figures %}
  {%- if loop.index0 > 0 and loop.index0 % cols == 0 %}<hr class="modal__rule">{% endif %}
  {%- set trf = tr.figures[loop.index0] if tr.figures else null %}
  <p class="modal__figure">
    <span class="modal__figure-value">{{ f.value | num(lang) }}</span>
    <span class="modal__figure-label">{{ (trf.label if trf else null) | t(f.label) }}</span>
  </p>
  {%- endfor %}
</div>
{%- endmacro %}

{%- macro dialog(id, title) %}
{%- set m = en.modals[id] %}
{%- set tr = c.modals[id] %}
{%- if m and (m.body or m.groups) %}
<dialog class="modal{% if m.groups %} modal--table{% elif m.wide %} modal--wide{% endif %}"
        id="modal-{{ id }}" aria-labelledby="modal-{{ id }}-title">
  {#- The close button is a child of the dialog, not of the box: the box is the
      scrolling element, and a button inside it scrolls away exactly when the
      reader is deepest into a long dialog and most likely to want out. #}
  <button class="modal__close" type="button" data-modal-close
          aria-label="{{ c.modals.close | t(en.modals.close) }}">&times;</button>
  <div class="modal__box">
  <div class="modal__scroll">
    <h2 class="modal__title" id="modal-{{ id }}-title">{{ title | plain }}</h2>
    {#- The body is a list of paragraphs, not one blob: the closing dialog is two
        in the design, and its second opens with a bold lead-in. Emphasis travels
        as **asterisks** so a translator edits plain text and cannot inject markup. #}
    {%- set paras = tr.body | tList(m.body) %}

    {%- if m.wide %}
    {#- `split` is the index of the first paragraph of the second column, and
        `figuresColumn` says which of the two the figures sit under. Stacked on a
        narrow screen the left column simply comes first. #}
    <div class="modal__cols">
      <div class="modal__col-a">
        {{ prose(paras, m, 0, m.split) }}
        {%- if m.figures and m.figuresColumn == 'left' %}{{ figures(m, tr) }}{% endif %}
      </div>
      <div class="modal__col-b">
        {{ prose(paras, m, m.split, paras.length) }}
        {%- if m.figures and m.figuresColumn != 'left' %}{{ figures(m, tr) }}{% endif %}
      </div>
    </div>
    {%- else %}
    {{ prose(paras, m, 0, paras.length) }}
    {#- The single-column frames set their one figure in the flow of the prose,
        in the display face, with the sentence that explains it underneath. #}
    {%- if m.figure %}
    {#- The file keeps this line on one line inside the 604px column. `--fig-chars`
        carries its length as it will actually be set, so a longer French figure
        shrinks to fit rather than breaking in two. #}
    {%- set figText = tr.figure | t(m.figure) %}
    <p class="modal__figure" style="--fig-chars:{{ figText | length }}">
      <span class="modal__figure-value">{{ figText }}</span>
      <span class="modal__figure-label">{{ tr.figureLabel | t(m.figureLabel) }}</span>
    </p>
    {%- endif %}
    {%- if m.image %}
    {#- Not a plain picture: a print, white-bordered and tipped, like every other
        photograph in the report. #}
    <figure class="modal__print">
      <div class="polaroid__frame">
        <picture>
          <source srcset="{{ (m.image | replace('.jpg', '.webp')) | asset }}" type="image/webp">
          <img class="modal__image" src="{{ m.image | asset }}" alt="{{ tr.imageAlt | t(m.imageAlt) }}"
               width="1400" height="933" loading="lazy" decoding="async">
        </picture>
      </div>
    </figure>
    {%- endif %}
    {%- endif %}

    {%- if m.groups %}
    {#- One table per group rather than one table with six sections: the card is
        1240 wide and 678 tall, which sixteen rows in a single column do not fit.
        Each group keeps its own caption, so the grouping survives for a screen
        reader as well as for the eye.

        The three columns are declared, not balanced. The file puts specific
        groups in specific columns and gives the third a different treatment
        altogether — two figures set large rather than a table of rows — which
        no column-balancing algorithm would ever arrive at on its own. `column`
        and `figures` are numbers and booleans, so the translation sheet, which
        only ever collects strings, never sees them. #}
    <div class="modal__tables">
      {%- for col in [1, 2, 3] %}
      <div class="modal__col">
        {%- for g in m.groups %}
        {%- if (g.column or 1) == col %}
        {%- set trg = tr.groups[loop.index0] if tr.groups else null %}
        {%- if g.figures %}
        <div class="modal__stats">
          <p class="modal__stats-caption">{{ (trg.name if trg else null) | t(g.name) }}</p>
          {%- for row in g.rows %}
          {%- set trr = trg.rows[loop.index0] if trg and trg.rows else null %}
          <p class="modal__stat">
            <span class="modal__stat-value">{{ row.value | num(lang) }}</span>
            <span class="modal__stat-label">{{ (trr.label if trr else null) | t(row.label) }}</span>
          </p>
          {%- endfor %}
        </div>
        {%- else %}
        <table class="modal__table">
          <caption>{{ (trg.name if trg else null) | t(g.name) }}</caption>
          <tbody>
            {%- for row in g.rows %}
            {%- set trr = trg.rows[loop.index0] if trg and trg.rows else null %}
            <tr>
              <th scope="row">{{ (trr.label if trr else null) | t(row.label) }}</th>
              <td>{{ row.value | num(lang) }}</td>
            </tr>
            {%- endfor %}
          </tbody>
        </table>
        {%- endif %}
        {%- endif %}
        {%- endfor %}
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
  </div>
</dialog>
{%- endif %}
{%- endmacro %}

{# The button, paired with the dialog above so the two can never drift apart.
   It renders only when there is something to open: a button that opens an empty
   box is worse than a button that is not there. #}
{%- macro trigger(id, label) %}
{%- if en.modals[id] and (en.modals[id].body or en.modals[id].groups) %}
<button class="tca" type="button" data-modal="{{ id }}">{{ label }}</button>
{%- endif %}
{%- endmacro %}
