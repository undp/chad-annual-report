{# Two footers stacked, because they answer to two different owners.

   The first is the report's own closing band — the download call to action the
   Figma design ends on. The second is the institutional footer of the UNDP
   Design System 2.0.3 (Footer organism, "simple" variant): its markup, and its
   compiled CSS from assets/vendor/undp-ds, so that it looks here as it does on
   every other UNDP property and in the Storybook the client checks it against.

   The design system's *default* variant also carries four navigation columns and
   a newsletter form. Both are left out: in the design system itself their content
   is the placeholder "Page title", and this site has no newsletter endpoint —
   inventing either would put dead links in a UN footer. #}

{#- The download band carries the same gradient and the same indent as a chapter
    opening: kicker on the column edge, the line that follows set in at 415px.
    The design gives the download no button box — the sentence is the link,
    drawn as the design system draws a link on a dark ground. #}
<section class="report-cta" aria-labelledby="report-cta-title">
  <div class="report-cta__inner">
    <p class="report-cta__kicker" id="report-cta-title">{{ c.footer.kicker | t(en.footer.kicker) }}</p>
    <p class="report-cta__action">
    {%- if assets.reportPdf[lang] %}
      <a class="report-cta__link" href="{{ (c.footer.file | t(en.footer.file)) | url }}" download>{{ c.footer.cta | t(en.footer.cta) }}</a>
    {%- else %}
      <span class="report-cta__link report-cta__link--pending" title="{{ c.header.downloadPending | t(en.header.downloadPending) }}">{{ c.footer.cta | t(en.footer.cta) }}</span>
    {%- endif %}
    </p>
  </div>
</section>

{%- set uf = c.undpFooter %}
{%- set enUf = en.undpFooter %}
{%- macro socialIcons() %}
  <ul class="footer-icons" aria-label="{{ uf.socialLabel | t(enUf.socialLabel) }}">
    {%- for s in site.undpFooter.social %}
    <li><a href="{{ s.url }}" class="{{ s.name }}" title="{{ s.title }}" rel="noopener" target="_blank">{{ s.title }}</a></li>
    {%- endfor %}
  </ul>
{%- endmacro %}

{#- The name beside the logo is the design system's `h5` (FooterLogo molecule),
    set here as a paragraph with the h5's measures: a heading level 5 with no
    1 to 4 above it in the footer would be a heading in name only. #}
<footer class="footer">
  <div class="grid-x">
    <div class="cell medium-10 medium-offset-1 footer-inner">
      <div class="grid-x footer-top">
        <div class="cell medium-5">
          <div class="footer-logo">
            <a href="{{ site.undpFooter.logoLink }}">
              <img src="{{ '/assets/vendor/undp-ds/images/undp-logo-white.svg' | asset }}"
                   alt="{{ uf.logoAlt | t(enUf.logoAlt) }}" width="60" height="123">
            </a>
            <p class="footer-logo__name">{{ uf.brandLine1 | t(enUf.brandLine1) }}<br>{{ uf.brandLine2 | t(enUf.brandLine2) }}</p>
          </div>
        </div>
        <div class="cell medium-5 show-large">
          {{ socialIcons() }}
        </div>
      </div>
      <div class="grid-x footer-bottom">
        <div class="cell medium-5">
          <p>{{ uf.copyright | t(enUf.copyright) }}</p>
        </div>
        <div class="cell medium-6">
          <ul class="footer-lists">
            {%- for l in enUf.links %}
            <li><a href="{{ site.undpFooter.links[loop.index0] }}">{{ uf.links[loop.index0].label | t(l.label) }}</a></li>
            {%- endfor %}
          </ul>
          <div class="show-small">
            {{ socialIcons() }}
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
