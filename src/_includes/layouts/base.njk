<!doctype html>
<html lang="{{ c.meta.lang }}" dir="{{ c.meta.dir | t('ltr') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set title = c.meta.title | t(en.meta.title) %}
  {%- set description = c.meta.description | t(en.meta.description) %}
  {%- set ogImage = site.url + ((c.meta.ogImage | t(en.meta.ogImage)) | asset) %}
  {%- set ogImageAlt = c.meta.ogImageAlt | t(en.meta.ogImageAlt) %}
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {#- The favicon is the one undp.org serves: the UN emblem tile of the logo,
      cut out of the design system's own file by scripts/vendor-undp-ds.mjs.
      Browsers that read SVG take the vector; the .ico and the touch icon sit at
      the root, where the rest look for them unasked (scripts/build-favicons.py).
      The sizes on the .ico keeps Chrome from preferring it to the SVG. #}
  <link rel="icon" href="{{ '/favicon.ico' | asset }}" sizes="32x32">
  <link rel="icon" href="{{ '/assets/vendor/undp-ds/images/undp-emblem.svg' | asset }}" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | asset }}">
  <meta name="theme-color" content="#ffffff">
  <link rel="canonical" href="{{ site.url }}/{{ lang }}/">
  {%- for l in site.langs %}
  <link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}/{{ l }}/">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/{{ site.defaultLang }}/">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ c.undpFooter.brandLine1 | t(en.undpFooter.brandLine1) }} {{ c.undpFooter.brandLine2 | t(en.undpFooter.brandLine2) }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}/{{ lang }}/">
  {#- 1200×630 is OG_SIZE in scripts/build-images.py. #}
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogImageAlt }}">
  <meta property="og:locale" content="{{ c.meta.locale | t(en.meta.locale) }}">
  {%- for l in site.langs %}{% if l != lang %}
  <meta property="og:locale:alternate" content="{{ copy[l].meta.locale }}">
  {%- endif %}{% endfor %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  <meta name="twitter:image:alt" content="{{ ogImageAlt }}">

  <link rel="preload" href="{{ '/assets/fonts/soehne-breit-web-fett.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/proximanova-regular-webfont.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/vendor/undp-ds/css/undp-ds.css' | asset }}">
  <link rel="stylesheet" href="{{ '/assets/css/tokens.css' | asset }}">
  <link rel="stylesheet" href="{{ '/assets/css/base.css' | asset }}">
  <link rel="stylesheet" href="{{ '/assets/css/sections.css' | asset }}">
  {%- if site.analytics.ga4 %}
  <!-- GA4 loads only after consent — see assets/js/consent.js -->
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
  gtag('consent','default',{ad_storage:'denied',analytics_storage:'denied'});
  window.GA4_ID='{{ site.analytics.ga4 }}';</script>
  {%- endif %}
  {#- The hero opens with an animation, and an animation needs a hidden state to
      open from. That state is written in CSS under `.js-hero`, and the class is
      set here rather than by the bundle so it is in place before the first
      paint — a hero that appears and then hides itself is worse than one that
      never animates. It is set only when motion is wanted, and dropped after
      six seconds regardless — past the end of the longest beat: if the bundle
      never arrives, the reader gets a still hero instead of an empty one. #}
  <script>
    (function () {
      var d = document.documentElement;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      d.classList.add('js-hero');
      setTimeout(function () { d.classList.remove("js-hero"); }, 6000);
    }());
  </script>
</head>
<body class="lang-{{ lang }}">
  <a class="skip-link" href="#main">{{ c.header.skipToContent | t(en.header.skipToContent) }}</a>
  {% include "sections/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "sections/footer.njk" %}
  <script type="module" src="{{ '/assets/js/bundle.js' | asset }}"></script>
</body>
</html>
