<link rel="canonical" href="https://annualreport.td.undp.org/en/">
<script>
  // Redirect to the visitor's language when we publish it, English otherwise.
  var supported = ['en', 'fr'];
  var pref = (navigator.languages || [navigator.language || 'en'])
    .map(function (l) { return String(l).slice(0, 2).toLowerCase(); })
    .find(function (l) { return supported.indexOf(l) > -1; }) || 'en';
  location.replace('./' + pref + '/');
</script>
<meta http-equiv="refresh" content="0; url=./en/">
</head>
<body>
